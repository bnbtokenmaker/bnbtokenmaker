{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:pricing": "tsx --test lib/pricing/tests/*.test.ts",
    "test": "tsx --test lib/pricing/tests/*.test.ts lib/draft/tests/*.test.ts lib/wallet/tests/*.test.ts lib/token/tests/*.test.ts lib/deploy/tests/*.test.ts lib/site/tests/*.test.ts",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:artifacts": "hardhat compile && node scripts/sync-contract-artifacts.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.5",
    "@tanstack/react-query": "^5.103.2",
    "@wagmi/connectors": "^8.2.0",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@nomicfoundation/hardhat-viem": "^2.1.5",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
