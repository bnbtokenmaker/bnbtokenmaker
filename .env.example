# WalletConnect (Reown) project ID — powers the mobile / QR "WalletConnect" option
# in the wallet modal. Create a free project at https://cloud.reown.com and paste
# the ID below. When this is empty, browser-extension wallets still work; the
# WalletConnect option is simply hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Google Analytics 4 measurement ID (public, e.g. G-0B1LCDWHW9 in production).
# When empty, analytics is disabled and the app renders normally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Phase 6B: BSC Testnet contract tooling (reads only, no secrets) ----
# BSC Testnet RPC for Hardhat reads. Defaults to a public endpoint when blank.
BSC_TESTNET_RPC_URL=
# BscScan Testnet API key for source verification. Leave blank until needed.
BSCSCAN_API_KEY=
# Factory contract address on BSC Testnet (chain 97). Recorded Phase 6B
# deployment (public, verified, fee-free); blank = Phase 6C refuses to
# build deployment transactions. Never put a mainnet address here.
NEXT_PUBLIC_TESTNET_FACTORY_ADDRESS=0x5357b13C30967197CF38b5FfAE2088417c562187

# ---- Phase 7A: Postgres persistence + admin auth (server-only) ----
# PostgreSQL connection string for deployment records + admin auth.
# Server-only: NEVER use a NEXT_PUBLIC_* name here. Leave blank in local
# dev (persistence routes return sanitized 503; unit tests use in-memory
# stores). Provision the real database after the architecture review, then
# run: DATABASE_URL="postgres://..." npm run db:migrate
DATABASE_URL=

# NOTE: BSC_TESTNET_RPC_URL (declared above) is reused by the Phase 7A
# server chain reader for deployment verification. Falls back to a public
# endpoint when blank. Server-only: never expose client-side.

# Admin session lifetime in hours (optional, default 12, clamped 1..168).
ADMIN_SESSION_TTL_HOURS=

# Bootstrap gate for `npm run admin:create` (CLI ONLY, never committed).
# Set a long random value in the production environment, use it once to
# create the initial admin, then you may unset it.
ADMIN_SETUP_TOKEN=

# Initial admin credentials for `npm run admin:create`. Provide via the
# environment at creation time — NEVER commit values here.
# ADMIN_INITIAL_IDENTIFIER=
# ADMIN_INITIAL_PASSWORD=

# NEVER add private keys, seed phrases, or mnemonics to this or any file.
