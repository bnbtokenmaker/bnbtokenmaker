# WalletConnect (Reown) project ID — powers the mobile / QR "WalletConnect" option
# in the wallet modal. Create a free project at https://cloud.reown.com and paste
# the ID below. When this is empty, browser-extension wallets still work; the
# WalletConnect option is simply hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Google Analytics 4 measurement ID (public, e.g. G-0B1LCDWHW9 in production).
# When empty, analytics is disabled and the app renders normally.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Phase 6B: BSC Testnet contract tooling (reads only, no secrets) ----
# BSC Testnet RPC for Hardhat reads and Phase 7A server verification.
# Outside production a public endpoint is used when blank; production
# requires an explicit value (deployment recording fails closed without it).
BSC_TESTNET_RPC_URL=
# BscScan Testnet API key for source verification. Leave blank until needed.
BSCSCAN_API_KEY=
# Factory contract address on BSC Testnet (chain 97). Recorded Phase 6B
# deployment (public, verified, fee-free); blank = Phase 6C refuses to
# build deployment transactions. Never put a mainnet address here.
NEXT_PUBLIC_TESTNET_FACTORY_ADDRESS=0x5357b13C30967197CF38b5FfAE2088417c562187
# Final V1 factory address on BSC Testnet (chain 97). Blank until 7D-F
# deploys the frozen V1 factory: while blank, the V1 create/deploy flow
# shows factory-unavailable and sends NO transaction (the legacy Phase 6B
# factory is never silently substituted for V1 calls).
NEXT_PUBLIC_V1_FACTORY_ADDRESS=

# Final V1 factory address on BSC Mainnet (chain 56). Blank until the mainnet
# factory is deployed. While blank, mainnet deployment shows factory-unavailable
# and sends NO transaction. NEVER put a testnet address here.
NEXT_PUBLIC_V1_MAINNET_FACTORY_ADDRESS=

# ---- Phase 7A: Postgres persistence + admin auth (server-only) ----
# PostgreSQL connection string for deployment records + admin auth.
# Server-only: NEVER use a NEXT_PUBLIC_* name here. Leave blank in local
# dev (persistence routes return sanitized 503; unit tests use in-memory
# stores). Provision the real database after the architecture review, then
# run: DATABASE_URL="postgres://..." npm run db:migrate
DATABASE_URL=

# NOTE: BSC_TESTNET_RPC_URL (declared above) is reused by the Phase 7A
# server chain reader for deployment verification. Outside production it
# falls back to a public endpoint when blank; in production an explicit
# value is required (fail-closed, no silent public default).
# Server-only: never expose client-side.

# Admin session lifetime in hours (optional, default 12, clamped 1..168).
ADMIN_SESSION_TTL_HOURS=

# ---- Phase 7D-E1: EIP-712 deployment-quote signer (SERVER-ONLY) ----
# The quote-signing key authorizes deployments against the frozen factory.
# SECRET values: NEVER use a NEXT_PUBLIC_* name, never log, never return
# from APIs, never persist, never commit values.
# NOT SECRET but server-side: signer address, factory address, chain ID, TTL.
# Leave unset until the commercial/testnet quote service is provisioned.
# Tests use injected/test-only signers and never read these.
#
# DEPLOY_QUOTE_SIGNER_KEY: 0x-prefixed 32-byte hex private key of the quote
#   signer. REQUIRED to issue authorizations. SECRET — never commit a value.
#DEPLOY_QUOTE_SIGNER_KEY=
#
# DEPLOY_QUOTE_SIGNER_ADDRESS: 0x address derived from the key above.
#   REQUIRED: the server cross-checks key→address on load and fails closed
#   on mismatch. NOT SECRET but server-side.
#DEPLOY_QUOTE_SIGNER_ADDRESS=
#
# DEPLOY_QUOTE_FACTORY_ADDRESS: frozen TokenFactory address for the quote
#   chain below. Authorizations bind this address (wrong-factory reverts).
#   NOT SECRET but server-side.
#DEPLOY_QUOTE_FACTORY_ADDRESS=
#
# DEPLOY_QUOTE_CHAIN_ID: chain the authorizations target (97 = BSC testnet;
#   56 = BSC mainnet, only after mainnet activation review).
#   NOT SECRET but server-side.
#DEPLOY_QUOTE_CHAIN_ID=
#
# DEPLOY_QUOTE_TTL_SECONDS: authorization lifetime in seconds (optional,
#   default 900, max 86400). NOT SECRET but server-side.
#DEPLOY_QUOTE_TTL_SECONDS=
#
# DEPLOY_QUOTE_ZERO_FEE: set "true" ONLY for the testnet quote service:
#   authorizations are signed with feeWei 0 (same architecture, no
#   commercial charge). MUST be absent/false for commercial chains.
#   For chain 56, the server REJECTS zero-fee at runtime (fail closed).
#DEPLOY_QUOTE_ZERO_FEE=

# ---- Phase 7D-F: Mainnet deployment (DEPLOY-TIME ONLY) ----
# These are used ONLY for the one-time mainnet factory deployment.
# SECRET: never commit values. Never expose client-side.
#
# MAINNET_DEPLOYER_KEY: 0x-prefixed 32-byte hex private key for the one-time
#   deployment transaction. SECRET — destroy after deployment.
#MAINNET_DEPLOYER_KEY=
#
# MAINNET_DEPLOYER_ADDRESS: expected deployer address (cross-check).
#   NOT SECRET but server-side.
#MAINNET_DEPLOYER_ADDRESS=
#
# MAINNET_FEE_RECIPIENT: factory fee recipient address (immutable).
#   NOT SECRET but server-side.
#MAINNET_FEE_RECIPIENT=
#
# MAINNET_MAX_FEE_WEI: factory MAX_FEE_WEI cap in wei (immutable).
#   NOT SECRET but server-side.
#MAINNET_MAX_FEE_WEI=

# Bootstrap gate for `npm run admin:create` (CLI ONLY, never committed).
# Set a long random value in the production environment, use it once to
# create the initial admin, then you may unset it.
ADMIN_SETUP_TOKEN=

# Initial admin credentials for `npm run admin:create`. Provide via the
# environment at creation time — NEVER commit values here.
# ADMIN_INITIAL_IDENTIFIER=
# ADMIN_INITIAL_PASSWORD=

# NEVER add private keys, seed phrases, or mnemonics to this or any file.
