2:Tb94,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do I need any coding or Solidity knowledge?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Tokens are generated from a standardized BEP-20 smart contract template. You configure the fields and controls visually — the contract itself is built for you."
      }
    },
    {
      "@type": "Question",
      "name": "Which network will my token be deployed on?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BNB Smart Chain, using the BEP-20 standard. Deployment happens from your wallet directly to BNB Chain, and your configuration can be previewed on the BNB testnet before a production launch."
      }
    },
    {
      "@type": "Question",
      "name": "Who owns the token after deployment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You do. Ownership of the smart contract is tied to the wallet address that deploys it, and you can transfer or renounce it later. The platform never holds your token."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost to create a BEP-20 token?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Creating a BEP-20 token has two costs: the BNB Token Maker platform fee for generating the contract and the BNB Smart Chain network gas for deploying it. Both are paid in BNB and both are shown before you sign — the platform fee in the builder and the network gas in your wallet. See the cost breakdown."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need BNB in my wallet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Your wallet needs enough BNB to cover the network fee for the deployment transaction on BNB Smart Chain."
      }
    },
    {
      "@type": "Question",
      "name": "Can I mint, burn or manage my token after deployment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, depending on which controls you enable. Mint, burn, pause and ownership management are optional smart contract features — they only exist in your contract if you turn them on."
      }
    },
    {
      "@type": "Question",
      "name": "Can BNB Token Maker access my private keys or funds?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. BNB Token Maker is non-custodial. The interface builds the transaction, but only your wallet signs it — your private keys and funds never leave your control."
      }
    },
    {
      "@type": "Question",
      "name": "Can I review and verify the smart contract?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The generated source can be inspected before deployment, and the deployed smart contract can be verified on BscScan afterwards so anyone can read it."
      }
    }
  ]
}
