2:T6aa,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is a BNB token the same as BNB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. BNB is the native cryptocurrency of BNB Smart Chain, used to pay network fees. A ‘BNB token’ usually means a separate BEP-20 token that runs on BNB Smart Chain — the two are different assets."
      }
    },
    {
      "@type": "Question",
      "name": "What is a BEP-20 token?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BEP-20 is the token standard used on BNB Smart Chain. It defines a common interface for balances, transfers and approvals, so tokens work with wallets, exchanges and protocols on the network."
      }
    },
    {
      "@type": "Question",
      "name": "Can a generator create BNB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. BNB is the network’s native currency and is managed by the chain’s own rules. A BNB token generator creates a new token that runs on BNB Smart Chain — not BNB itself."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need coding to create a token?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You configure the token, and the generated BEP-20 contract is deployed from your wallet with a signed transaction."
      }
    },
    {
      "@type": "Question",
      "name": "Who owns the token I create?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your wallet does. Ownership is tied to the deploying address and can be transferred or renounced later."
      }
    }
  ]
}
