7:["$","section",null,{"className":"section reveal is-in","id":"what-is-bep20","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"sec-head","children":[["$","div",null,{"className":"kicker","children":"What is BEP-20?"}],["$","h2",null,{"children":"BEP-20: the standard for BNB Smart Chain tokens."}]]}],["$","div",null,{"className":"guide-sec","children":[["$","p",null,{"children":["BEP-20 is the token standard on BNB Smart Chain, the network secured and powered by BNB. It defines how a token tracks balances, moves value and grants approvals. Because it mirrors ERC-20, most wallets, exchanges and decentralized apps already understand it without any special support. The current specification lives in the official ",["$","a",null,{"href":"https://github.com/bnb-chain/BEPs/blob/master/BEPs/BEP20.md","children":"BEP-20 proposal"}]," maintained by BNB Chain."]}],["$","p",null,{"children":"Common examples on the ecosystem include fiat-backed stablecoins, wrapped assets and the thousands of community tokens issued on the chain. Creating one with BNB Token Maker is a configuration task: name, symbol, supply and optional controls — no Solidity required."}],["$","p",null,{"className":"sec-cta","children":["$","a",null,{"href":"/bep20-token-generator","children":["Explore the BEP-20 Token Generator ",["$","i",null,{"className":"fa-solid fa-arrow-right","aria-hidden":"true"}]]}]}]]}]]}]}]
8:["$","section",null,{"className":"section reveal is-in","id":"what-is-erc20","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"sec-head","children":[["$","div",null,{"className":"kicker","children":"What is ERC-20?"}],["$","h2",null,{"children":"ERC-20: the original standard, born on Ethereum."}]]}],["$","div",null,{"className":"guide-sec","children":[["$","p",null,{"children":["ERC-20 (Ethereum Request for Comment 20) is the fungible token standard that launched a wave of token economies. Its proposal standardized six functions and two events that any token wallet, exchange or smart contract could rely on, making tokens interoperable across Ethereum tooling. Ethereum's ",["$","a",null,{"href":"https://ethereum.org/en/developers/docs/standards/tokens/erc-20/","children":"official ERC-20 developer reference"}]," documents the complete interface."]}],["$","p",null,{"children":"Nearly every later chain — including BNB Smart Chain — adopted the same interface for its own tokens, which is why BEP-20 and ERC-20 read identically. The difference is purely where they settle: Ethereum for ERC-20, BNB Smart Chain for BEP-20."}]]}]]}]}]
9:["$","section",null,{"className":"section reveal is-in","id":"choose","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"sec-head","children":[["$","div",null,{"className":"kicker","children":"How to choose"}],["$","h2",null,{"children":"Pick the chain your audience already uses."}]]}],["$","div",null,{"className":"feat-grid","children":[["$","div",null,{"className":"feat","children":[["$","div",null,{"className":"feat-top","children":[["$","span",null,{"className":"feat-idx","children":"01"}],["$","span",null,{"className":"feat-state on","children":"BEP-20"}]]}],["$","h3",null,{"children":"You want to build on BNB Smart Chain"}],["$","p",null,{"children":"If your community, dApps or listing targets live on BSC, BEP-20 is the standard they expect. You also typically pay less per operation than Ethereum for similar traffic."}]]}],["$","div",null,{"className":"feat","children":[["$","div",null,{"className":"feat-top","children":[["$","span",null,{"className":"feat-idx","children":"02"}],["$","span",null,{"className":"feat-state on","children":"ERC-20"}]]}],["$","h3",null,{"children":"You must reach Ethereum users"}],["$","p",null,{"children":"If your holders, exchanges or DeFi pools are on Ethereum, ERC-20 is the natural fit. The standard is identical — the cost and speed trade-offs belong to the network."}]]}],["$","div",null,{"className":"feat","children":[["$","div",null,{"className":"feat-top","children":[["$","span",null,{"className":"feat-idx","children":"03"}],["$","span",null,{"className":"feat-state on","children":"Either"}]]}],["$","h3",null,{"children":"You are just comparing ecosystems"}],["$","p",null,{"children":"There is no universal winner. Choose by where you want the token to live, then deploy with tooling that matches that chain."}]]}]]}]]}]}]
