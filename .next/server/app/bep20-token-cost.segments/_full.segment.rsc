1a:T9cc,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does it cost to create a BEP-20 token?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Creating a BEP-20 token involves two separate costs: the BNB Token Maker platform fee for generating the contract, and the BNB Smart Chain network gas for the deployment transaction. The platform fee is shown in the builder before you connect your wallet; the network gas is set by the chain and shown in your wallet before you sign."
      }
    },
    {
      "@type": "Question",
      "name": "Is network gas included in the platform fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Network gas is a separate cost paid to BNB Smart Chain, not to BNB Token Maker. The platform fee covers generating your contract and the two are never mixed."
      }
    },
    {
      "@type": "Question",
      "name": "Why does BNB Smart Chain gas change?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Network gas is set by the chain based on demand and congestion. Busy periods cost more, quieter periods cost less. Your wallet always shows the exact network fee before you approve the deployment, so you can wait and retry if it is higher than you want."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need BNB in my wallet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. BNB is the native currency of BNB Smart Chain, so your wallet needs enough BNB to cover both the platform fee and the network gas for the deployment transaction."
      }
    },
    {
      "@type": "Question",
      "name": "Can token features affect the platform fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The base BEP-20 contract is included at a base platform price, and optional controls such as burn, mint, pause, max transaction, max wallet, blacklist and whitelist add a small per-feature surcharge. The exact total is shown in the builder as you configure."
      }
    },
    {
      "@type": "Question",
      "name": "Can I review the cost before deployment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The builder shows your platform fee total as you select features, and your wallet shows the network gas amount just before you sign. You only pay after you explicitly confirm both."
      }
    }
  ]
}
