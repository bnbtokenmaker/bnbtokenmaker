2:T49e,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is a verified contract the same as an audited contract?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Verification proves the published source matches the deployed bytecode and makes it publicly readable. An audit is a separate third-party review of the code. A verified contract is not automatically audited."
      }
    },
    {
      "@type": "Question",
      "name": "Who can submit a contract for verification?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BscScan requires you to prove that you are the deploying address, usually by connecting that wallet and signing a message, before the contract can be verified."
      }
    },
    {
      "@type": "Question",
      "name": "Is verification required to use a token?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A token works without verification, and many contracts are never verified. Verification is an optional transparency step that makes the deployed source publicly inspectable."
      }
    }
  ]
}
