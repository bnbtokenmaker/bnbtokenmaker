3:["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"How long does deployment take?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Deployment is a single network transaction. Once the network confirms it, your contract is live. This is usually quick but varies with network conditions, so there's no guaranteed time — check your wallet and the explorer for the current status."}]}]]}]}]
4:["$","section",null,{"className":"faq-cat","data-cat":"token-creation","children":[["$","h2",null,{"className":"faq-cat-title","children":["Token Creation ",["$","span",null,{"className":"fc-count","children":"4"}]]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What information do I need to create a token?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"A name, a symbol, a decimal setting and an initial supply. Beyond that, you can enable the contract features you want before you connect your wallet."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What decimals should I use?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"18 decimals is the BEP-20 default and what most of the ecosystem expects — it keeps your token familiar to wallets and explorers. You can set fewer (down to 0) if you intentionally want whole-number units."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Can I change the name or symbol after deployment?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"No. The name and symbol are written into the contract at deployment and can never be changed afterwards. Decide on them before you deploy."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Can the supply change after launch?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Only if you enabled the Mintable feature — the owner can then create new supply at any time. With Fixed Supply, the total is permanently locked. A Burnable token's supply can only go down, never up."}]}]]}]}]]}]
5:["$","section",null,{"className":"faq-cat","data-cat":"features","children":[["$","h2",null,{"className":"faq-cat-title","children":["Features ",["$","span",null,{"className":"fc-count","children":"7"}]]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What's the difference between Mintable and Fixed Supply?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Mintable lets the owner create additional supply after launch; Fixed Supply locks the total forever. The two are mutually exclusive, so you choose one when configuring."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What does Burnable mean?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Burnable lets the owner permanently remove tokens from circulation. Burned tokens can never be restored, so it permanently reduces the available supply."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What is Pausable used for?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Pausable lets the owner stop and resume all transfers instantly. It's a common emergency valve to pause trading during a launch window or an incident."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What are the Max Transaction and Max Wallet limits?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"They cap how tokens move. Max Transaction Limit caps the amount any single transfer can move; Max Wallet Limit caps the amount any single wallet can hold. Both are set as a share of the total supply during configuration."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Can I use Blacklist and Whitelist together?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"No — they're mutually exclusive. Blacklist blocks specific addresses from holding or transferring; Whitelist restricts holding and transferring to only approved addresses."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What does Renounce Ownership do?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"It permanently locks the contract. After renouncing, no one — not even you — can change the contract, use owner functions or restore control. The action is irreversible once confirmed."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Can I transfer ownership later?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Yes. Ownership can be handed to a multisig, a DAO or any other wallet at any time, and the new owner inherits every owner-only function."}]}]]}]}]]}]
6:["$","section",null,{"className":"faq-cat","data-cat":"wallet-fees","children":[["$","h2",null,{"className":"faq-cat-title","children":["Wallet & Fees ",["$","span",null,{"className":"fc-count","children":"5"}]]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Do I need BNB to create a token?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Yes. You need BNB on the deploying wallet to cover two costs: the BNB Token Maker platform fee for generating the contract, and the network gas the chain charges to deploy it."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What is the platform fee?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":["It's the one-time fee for generating your BEP-20 contract through BNB Token Maker. You see the exact amount in the create flow before you connect your wallet, and it's charged in BNB. For the full picture of platform fee vs network gas, see ",["$","a",null,{"href":"/bep20-token-cost","children":"BEP-20 token creation costs"}],"."]}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"What is network gas?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Network gas is the fee BNB Smart Chain charges to confirm your deployment transaction. It's paid in BNB, set by the network, and your wallet always shows the amount before you sign."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Why does the fee vary?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"Network gas moves with demand and congestion — busy times cost more, quiet times cost less. Your wallet shows the current network fee before you approve. If it's higher than you'd like, you can wait and try again."}]}]]}]}],["$","div",null,{"className":"faq-item","children":["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"Does BNB Token Maker hold my funds?"}],["$","i",null,{"className":"fa-solid fa-chevron-down","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-a","children":["$","p",null,{"children":"No — the platform is non-custodial. BNB Token Maker never holds or moves your BNB. Fees are paid through signed wallet transactions, and everything else stays under your control."}]}]]}]}]]}]
