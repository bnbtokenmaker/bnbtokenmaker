13:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebSite\",\n  \"name\": \"BNB Token Maker\",\n  \"url\": \"https://bnbtokenmaker.com\",\n  \"description\": \"Create a BEP-20 token on BNB Smart Chain without writing Solidity.\"\n}\n"}}],["$","section",null,{"className":"page","id":"top","children":["$","div",null,{"className":"container","children":[["$","header",null,{"className":"page-head reveal is-in","children":[["$","div",null,{"className":"kicker","children":[["$","span",null,{"className":"dot"}],"Legal"]}],["$","h1",null,{"children":"Privacy Policy"}],["$","p",null,{"className":"lede","children":"How information is handled when you use BNB Token Maker."}],["$","span",null,{"className":"legal-status","children":[["$","i",null,{"className":"fa-solid fa-circle-info","aria-hidden":"true"}],"Prototype build — final legal details to be confirmed before public release"]}]]}],["$","div",null,{"className":"legal-doc","children":[["$","p",null,{"children":"This policy explains what information BNB Token Maker may handle when you use the Service, and how we treat it. It is written for a prototype build: as the service matures, this page will be updated to reflect how information is actually processed."}],["$","section",null,{"className":"legal-sec","children":[["$","h2",null,{"children":[["$","span",null,{"className":"lno","children":"01"}],"Overview"]}],["$","p",null,{"children":["BNB Token Maker is designed to be ",["$","b",null,{"children":"non-custodial"}]," and to keep most of the token creation process running on your own device. In general, the less information that passes through our systems, the better. This policy describes what little information may be involved."]}]]}],["$","section",null,{"className":"legal-sec","children":[["$","h2",null,{"children":[["$","span",null,{"className":"lno","children":"02"}],"Information You Provide"]}],["$","p",null,{"children":["If the contact form is enabled, you may choose to provide your ",["$","b",null,{"children":"name, email address, selected topic and message"}]," when contacting us. You are under no obligation to provide this information, and the contact form does not collect it unless you submit it."]}]]}],["$","section",null,{"className":"legal-sec","children":[["$","h2",null,{"children":[["$","span",null,{"className":"lno","children":"03"}],"Wallet Information"]}],["$","p",null,{"children":["BNB Token Maker ",["$","b",null,{"children":"never asks users to provide seed phrases or private keys"}],". When you use a wallet or create using a connected wallet, only the actions that need your wallet — such as approving a deployment — are initiated by you. We do not collect, store or access your private key or seed phrase, and you should never share them with us or anyone else."]}]]}],["$","section",null,{"className":"legal-sec","children":[["$","h2",null,{"children":[["$","span",null,{"className":"lno","children":"04"}],"Blockchain Data"]}],["$","p",null,{"children":["When a token is deployed, the ",["$","b",null,{"children":"configuration of the contract and the public address of the deploying wallet"}]," are recorded on the blockchain. This data is ",["$","b",null,{"children":"public and permanent"}],". Anyone can read deployed contracts and transaction history through an explorer. On-chain records cannot be deleted."]}]]}],["$","section",null,{"className":"legal-sec","children":[["$","h2",null,{"children":[["$","span",null,{"className":"lno","children":"05"}],"Technical Information"]}],["$","p",null,{"children":"Like most websites, the infrastructure serving this site may process basic technical data such as IP addresses, browser type and request logs for security and operational purposes. Any such data is handled as operational data and is not used to build profiles of visitors."}]]}],["$","section",null,{"className":"legal-sec","children":[["$","h2",null,{"children":[["$","span",null,{"className":"lno","children":"06"}],"Cookies and Local Storage"]}],"$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}]]}]}]],["$L26"],"$L27"]}]
