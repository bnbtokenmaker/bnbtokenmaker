1b:["$","section",null,{"className":"legal-sec","children":[["$","h2",null,{"children":[["$","span",null,{"className":"lno","children":"07"}],"Analytics"]}],["$","p",null,{"children":["The website uses ",["$","b",null,{"children":"Google Analytics"}]," to understand aggregate website usage and performance (for example, which pages are visited). Google Analytics is provided by Google and ",["$","b",null,{"children":"may use cookies or similar technologies"}],". Information collected through Google Analytics is handled according to Google's own policies. The site does not currently operate a consent-management tool for analytics."]}]]}]
