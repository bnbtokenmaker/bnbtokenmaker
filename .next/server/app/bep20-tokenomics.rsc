2c:["$","p",null,{"children":["If you want to compare supply sizes as a matter of rem for the builder, our ",["$","a",null,{"href":"/bep20-token-cost","children":"BEP-20 token cost guide"}]," covers the fee side of configuration; supply itself does not change the fee."]}]
2d:["$","section",null,{"className":"post-sec","id":"decimals","children":[["$","h2",null,{"children":[["$","span",null,{"className":"no","children":"04"}],"What BEP-20 decimals actually change"]}],["$","p",null,{"children":["Decimals control how finely a single token unit can be divided for display. ",["$","b",null,{"children":"18"}]," is the BEP-20 default and the most compatible value for wallets and exchanges."]}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"18 decimals"}]," — the default. Each unit can be split into tiny fractions; how it's displayed is up to each wallet."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"0–17 decimals"}]," — fewer decimals mean larger display units. 0 gives whole-number units; balances display as integers."]}]]}]]}],["$","p",null,{"children":["Decimals affect ",["$","b",null,{"children":"display granularity"}],", not value. A token at 0 decimals with a supply of 1,000,000 is not worth more than one at 18 decimals with the same supply — the decimal setting only changes how the number is read. Whatever you choose is fixed once the contract is on-chain."]}]]}]
2e:["$","section",null,{"className":"post-sec","id":"distribution","children":[["$","h2",null,{"children":[["$","span",null,{"className":"no","children":"05"}],"Token distribution planning"]}],["$","p",null,{"children":"Distribution describes where the initial supply goes. All of it is minted to your deploying wallet at deployment, so a plan usually means deciding how you will move it afterwards — and checking that your enabled limits allow those moves."}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Keep it spread."}]," A single wallet holding the entire supply is fragile. If others will hold it, plan transfers or sends that respect your wallet and transaction limits."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Reserve for future needs."}]," With fixed supply, anything not distributed at launch is simply held — there is no separate reserve contract."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Distribution ≠ adoption."}]," How tokens move after launch is up to the actual roadmap and activity of the project, not to any contract setting."]}]]}]]}],["$","p",null,{"children":["Planning distribution before choosing limits avoids surprises: set ",["$","b",null,{"children":"Max Wallet"}]," and ",["$","b",null,{"children":"Max Transaction"}]," only if they match how you really intend tokens to move."]}]]}]
2f:["$","section",null,{"className":"post-sec","id":"burn","children":[["$","h2",null,{"children":[["$","span",null,{"className":"no","children":"06"}],"Burnable tokens and supply reduction"]}],["$","p",null,{"children":["Burning permanently removes tokens from circulation. In the builder this is available only when you enable the ",["$","b",null,{"children":"Burnable"}]," feature, giving the owner a designated burn action."]}],["$","p",null,{"children":["Burning changes the ",["$","b",null,{"children":"circulating"}]," amount; it does not change the contract's configured total. A smaller circulating supply is not a guarantee of demand — it is a supply decision with consequences you should weigh before launch."]}],["$","div",null,{"className":"callout","children":[["$","i",null,{"className":"fa-solid fa-circle-info","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Burning is one-way."}]," Tokens sent to the burn mechanism cannot be recovered, so plan any burns deliberately and never burn tokens you still need."]}]]}]]}]
30:["$","section",null,{"className":"post-sec","id":"ownership","children":[["$","h2",null,{"children":[["$","span",null,{"className":"no","children":"07"}],"Ownership and minting authority"]}],["$","p",null,{"children":["By default the deploying wallet is the ",["$","b",null,{"children":"owner"}]," and controls every enabled feature — minting, burning, pausing, and any list-based features. That is the single most important relationship in your tokenomics: whoever owns the contract controls the supply levers."]}],["$","p",null,{"children":["Ownership can later be ",["$","b",null,{"children":"transferred"}]," to another wallet or ",["$","b",null,{"children":"renounced"}],". Renouncing can be permanent and irreversible depending on the contract's behavior, so it is a decision to make deliberately, not casually. Walk through the trade-offs in our ",["$","a",null,{"href":"/bep20-token-security-checklist","children":"BEP-20 token security checklist"}],", which covers ownership as a launch decision."]}],["$","p",null,{"children":"There is no objectively \"safe\" setting: keeping ownership keeps flexibility, renouncing removes your control. Both are legitimate, and neither removes the need to understand who can do what after launch."}]]}]
