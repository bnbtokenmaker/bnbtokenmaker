2:Te87,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I create a meme coin on BNB Smart Chain?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. A meme coin on BNB Smart Chain is a BEP-20 token, and BNB Token Maker generates one from a few configuration fields. You set the name, symbol and supply, pick optional controls, connect a wallet and deploy to BNB Smart Chain (Chain ID 56)."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to write code to create a meme coin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. BNB Token Maker is a no-code generator: the BEP-20 contract is created behind the scenes from the fields you fill in. You never edit Solidity or handle ABI files during creation."
      }
    },
    {
      "@type": "Question",
      "name": "What can I configure for a meme coin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The essentials are the token name, symbol, total supply and decimals. Above that, optional controls available today include burnable, mintable and pausable tokens, a max transaction amount, a max wallet balance, and blacklist or whitelist modes. Ownership transfer and renounce are included."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost to create a meme coin on BNB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Creating a meme coin on BNB Smart Chain has two costs: the BNB Token Maker platform fee for generating the contract and the BNB Smart Chain network gas for deploying it. Both are paid in BNB and both are shown before you sign — the platform fee in the builder and the network gas in your wallet."
      }
    },
    {
      "@type": "Question",
      "name": "Can a meme coin be burnable or mintable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Burnable lets the contract destroy tokens to permanently reduce supply, and mintable lets more tokens be created later under owner control. Both are optional controls in the builder today."
      }
    },
    {
      "@type": "Question",
      "name": "Does BNB Token Maker support buy/sell tax, marketing wallet or anti-bot for meme coins?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not yet. Features such as buy/sell tax, marketing wallet, fee exemption, anti-bot and auto liquidity are marked as coming soon on the roadmap. Today the builder covers supply and transfer controls; advanced trading features will be added later."
      }
    },
    {
      "@type": "Question",
      "name": "Can I set max transaction or max wallet limits on a meme coin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can cap the maximum tokens per transaction and the maximum balance a single wallet can hold, which are common ways to discourage concentrated holdings after launch."
      }
    },
    {
      "@type": "Question",
      "name": "Can I renounce ownership of my meme coin?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Renounce ownership is included: it locks the contract to its final form on-chain. It is irreversible, so once executed no one — including you — can change the contract."
      }
    },
    {
      "@type": "Question",
      "name": "Which network does my meme coin deploy on?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BNB Smart Chain mainnet, Chain ID 56. Your wallet must have the network selected and hold enough BNB to cover the platform fee and network gas."
      }
    }
  ]
}
