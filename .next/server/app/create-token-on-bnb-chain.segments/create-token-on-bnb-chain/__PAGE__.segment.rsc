d:["$","section",null,{"className":"section reveal is-in","id":"features","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"sec-head","children":[["$","div",null,{"className":"kicker","children":"Features"}],["$","h2",null,{"children":"Token features on BNB Smart Chain."}]]}],["$","div",null,{"className":"guide-sec","children":[["$","p",null,{"children":["Aside from standard BEP-20 transfers, a deployed token can include optional controls: ",["$","strong",null,{"children":"minting"}]," to create more supply, ",["$","strong",null,{"children":"burning"}]," to remove supply permanently, ",["$","strong",null,{"children":"pausing"}]," to stop transfers in an emergency, and ",["$","strong",null,{"children":"ownership management"}]," for the contract’s admin role."]}],["$","p",null,{"children":["Keep in mind that a feature only exists if it is enabled in the configuration — the contract contains exactly what you choose. Browse the ",["$","a",null,{"href":"/features","children":"full feature reference"}]," before deploying. Community projects often combine a large supply with max-transaction and max-wallet limits; a typical setup is shown in the ",["$","a",null,{"href":"/create-meme-coin-bnb-chain","children":"meme coin configuration example"}],"."]}]]}]]}]}]
