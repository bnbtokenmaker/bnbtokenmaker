2:T6a0,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does ‘deploy a token’ mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Deploying creates the token’s smart contract on BNB Smart Chain. Once confirmed, the contract has a permanent address and the token exists on-chain."
      }
    },
    {
      "@type": "Question",
      "name": "Which network are tokens deployed on?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BNB Smart Chain (Chain ID 56), using the BEP-20 standard. Deployment transactions are paid for in BNB."
      }
    },
    {
      "@type": "Question",
      "name": "How is the deployment transaction signed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "By your wallet. BNB Token Maker prepares the deployment, and your wallet signs and broadcasts the transaction. Your private key never leaves your wallet."
      }
    },
    {
      "@type": "Question",
      "name": "What do I need before deploying?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A wallet connected to BNB Smart Chain, enough BNB to cover the network fee, and your token configuration — name, symbol, supply, decimals and optional controls."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know my token was deployed correctly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After confirmation, the contract receives a public address. The generated source is available for verification on BscScan, so you can inspect the contract yourself."
      }
    }
  ]
}
