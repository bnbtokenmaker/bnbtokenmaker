1a:T4ed,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Will a very high supply make my community token more valuable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Supply size is a display choice stored in the contract. A high total divided among more units does not add value by itself - what matters is whether the design fits how the community actually uses the token."
      }
    },
    {
      "@type": "Question",
      "name": "Are tax, marketing and anti-bot features available today?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not yet. Buy and sell tax, marketing wallet, fee exemption, anti-bot and auto liquidity are planned features on the roadmap and remain a work in progress. They are visible as Coming Soon and are not part of today's create flow."
      }
    },
    {
      "@type": "Question",
      "name": "Can I change my supply after deployment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Only if the token is mintable and the owner holds minting authority. A fixed supply token cannot be increased after deployment, so decide the supply before you launch."
      }
    }
  ]
}
