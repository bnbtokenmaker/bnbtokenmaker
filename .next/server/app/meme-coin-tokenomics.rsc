24:["$","section",null,{"className":"post-sec","id":"distribution","children":[["$","h2",null,{"children":[["$","span",null,{"className":"no","children":"04"}],"Distribution planning"]}],["$","p",null,{"children":"The initial supply is minted to your deploying wallet, so \"distribution\" is really a plan for moving it afterwards. Concentration is the design risk to watch."}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Avoid one-wallet dominance."}]," If a single wallet holds everything at launch, no community can meaningfully participate."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Plan the first moves."}]," Whatever air-drops, giveaways or transfers you intend must fit inside your enabled transaction and wallet limits."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Keep the deploying wallet clean."}]," Consider separating the wallet that deploys from the wallets that hold community allocations."]}]]}]]}],["$","p",null,{"children":"There is no magic ratio — the right distribution is the one a given community can actually use."}]]}]
25:["$","section",null,{"className":"post-sec","id":"fixed-vs-mintable","children":[["$","h2",null,{"children":[["$","span",null,{"className":"no","children":"05"}],"Fixed vs mintable supply"]}],["$","p",null,{"children":"These options are mutually exclusive, so choose deliberately:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Fixed supply"}]," — the full amount is minted once. Predictable, no minting authority exists afterwards."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Mintable"}]," — the owner can create more supply after launch, which leaves an ongoing minting authority to manage."]}]]}]]}],["$","p",null,{"children":"Many community tokens prefer a fixed supply for its simplicity, but that's a design taste, not a rule. The controlling question is what the minting authority would be used for — and who holds it."}]]}]
26:["$","section",null,{"className":"post-sec","id":"limits","children":[["$","h2",null,{"children":[["$","span",null,{"className":"no","children":"06"}],"Max Wallet and Max Transaction limits"]}],["$","p",null,{"children":"Limits are expressed as a share of total supply and apply to everyone, including you. Use them to pace movement, not to look protective."}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Max Transaction"}]," caps each transfer. It slows large single moves but also caps your own distribution batches."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":[["$","b",null,{"children":"Max Wallet"}]," caps any wallet's balance. It spreads holding but can block a whale-sized holder from receiving tokens."]}]]}],["$","li",null,{"children":[["$","i",null,{"className":"fa-solid fa-circle-check","aria-hidden":"true"}],["$","span",null,{"children":"Re-check limits against your distribution plan — the two are designed together, not separately."}]]}]]}]]}]
