2:T6f2,{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to create a BEP-20 token?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once the token is configured and your wallet is connected, deployment is one or two signed transactions. Confirmation on BNB Smart Chain is typically a matter of seconds to minutes, depending on network conditions."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to write code or use a compiler?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The generator builds the BEP-20 contract from your configuration. You review the token details and confirm the deployment in your wallet."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need BNB to create a BEP-20 token?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — enough to cover the network fee for the deployment transaction. The fee is paid in BNB from your wallet."
      }
    },
    {
      "@type": "Question",
      "name": "Can I change the token name or supply after deployment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The name, symbol, decimals and initial supply are fixed at deployment. If you enabled minting, additional supply can be created later through the contract."
      }
    },
    {
      "@type": "Question",
      "name": "Who controls the token after I deploy it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your wallet. Ownership is tied to the address that deploys the contract and can be transferred or renounced later. See the ownership documentation for details."
      }
    }
  ]
}
3:T644,{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Create a BEP-20 Token on BNB Smart Chain | BNB Token Maker",
  "description": "Step-by-step guide to creating a BEP-20 token: what you need, the five steps from configuration to deployment, and common mistakes to avoid. No Solidity required.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Define your token",
      "text": "Set the token name, symbol, decimals and total supply to mint at launch. These values are fixed once the contract is deployed."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Choose the token controls",
      "text": "Decide which optional features to include: mint to create supply later, burn to remove supply permanently, pause to halt transfers, and ownership for contract management."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Connect your wallet",
      "text": "Connect a wallet to BNB Smart Chain. The generator prepares the deployment, but signing happens only inside your wallet."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Review the contract",
      "text": "Check the configuration one last time, since the on-chain values come from exactly what you review before deployment."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": "Deploy to BNB Smart Chain",
      "text": "Confirm the transaction in your wallet. The network processes it, the fee is paid in BNB, and your token contract is created on BNB Smart Chain."
    }
  ]
}
